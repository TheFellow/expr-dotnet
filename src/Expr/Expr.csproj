<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Expr</AssemblyName>
    <RootNamespace>Expr</RootNamespace>
    <Description>A faithful, safe, and fast C# semantic port of expr-lang/expr.</Description>
    <PackageId>Expr</PackageId>
    <PackageTags>expression;expression-language;compiler;bytecode;interpreter;rules</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/TheFellow/expr-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheFellow/expr-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageVersion>0.1.0-alpha.1</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>

