<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Expr</AssemblyName>
    <RootNamespace>Expr</RootNamespace>
    <Description>A safe, statically checked expression language for modern .NET with a public AST and bounded bytecode runtime.</Description>
    <PackageId>Expr</PackageId>
    <Authors>TheFellow contributors</Authors>
    <Copyright>Copyright (c) 2026 TheFellow contributors</Copyright>
    <PackageTags>expression;expression-language;compiler;bytecode;interpreter;rules;rules-engine;ast;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/TheFellow/expr-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheFellow/expr-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageVersion>0.3.0</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
